let _mapInstance  = null;
let _mapLayers    = null;

function renderMapTab(){
  return `<div class="w-full h-full min-h-[480px] flex flex-col">
    <div id="leaflet-map" class="flex-1 rounded-xl overflow-hidden border border-slate-200 shadow-inner relative" style="min-height:460px;">
      <div id="map-loader" class="absolute inset-0 flex items-center justify-center bg-slate-100 z-[600]">
        <div class="flex flex-col items-center gap-3">
          <svg class="w-8 h-8 text-blue-500 spin" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span class="font-semibold text-slate-600 text-sm">Loading Geospatial Engine...</span>
        </div>
      </div>
    </div>
  </div>`;
}

function initMap(){
  if(_mapInstance){ _mapInstance.remove(); _mapInstance=null; _mapLayers=null; }

  const container = document.getElementById('leaflet-map');
  if(!container) return;
  const loader = document.getElementById('map-loader');

  const baseCoords = [23.0384, 72.5298];
  _mapInstance = L.map(container,{zoomControl:true,scrollWheelZoom:true}).setView(baseCoords,13);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',{
    attribution:'&copy; OpenStreetMap &copy; CARTO', maxZoom:19
  }).addTo(_mapInstance);

  const redIcon = L.divIcon({className:'',html:`<div style="background:#dc2626;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 3px 8px rgba(0,0,0,.4)"></div>`,iconSize:[16,16],iconAnchor:[8,8]});
  const blueIcon = L.divIcon({className:'',html:`<div style="background:#2563eb;width:14px;height:14px;border-radius:50%;border:2px solid white;box-shadow:0 2px 5px rgba(0,0,0,.3)"></div>`,iconSize:[14,14],iconAnchor:[7,7]});

  const fg = L.featureGroup().addTo(_mapInstance);
  _mapLayers = fg;

  // Last known location
  L.marker(baseCoords,{icon:redIcon})
    .bindPopup(`<b style="color:#dc2626;font-size:11px;text-transform:uppercase">Last Seen Location</b><br/><b style="font-size:14px">${caseData.intake.lastKnownLocation}</b>`)
    .addTo(fg);

  // 2 km search radius
  L.circle(baseCoords,{color:'#dc2626',fillColor:'#dc2626',fillOpacity:.07,radius:2000,weight:2,dashArray:'6,6'}).addTo(fg);

  // Sort logs chronologically
  const sorted = [...caseData.logs].sort((a,b)=>new Date(a.timestamp)-new Date(b.timestamp));

  sorted.forEach(log=>{
    if(!log.coords) return;
    L.marker(log.coords,{icon:blueIcon})
      .bindPopup(`<b style="color:#2563eb;font-size:11px;text-transform:uppercase">${log.source}</b><br/>
        <b style="font-size:13px">${fmtDate(log.timestamp)}</b><br/>
        <b style="font-size:14px;display:block;margin-top:4px">${log.location}</b>
        <p style="font-size:13px;color:#475569;margin-top:6px;line-height:1.4">${log.description}</p>`)
      .addTo(fg);
  });

  // Trajectory line
  const path = [baseCoords, ...sorted.filter(l=>l.coords).map(l=>l.coords)];
  if(path.length>1) L.polyline(path,{color:'#2563eb',weight:3,opacity:.8,dashArray:'8,8'}).addTo(fg);

  // Fit bounds
  setTimeout(()=>{
    if(_mapInstance && _mapLayers){
      try{ _mapInstance.fitBounds(_mapLayers.getBounds().pad(0.15)); }catch(_){}
      _mapInstance.invalidateSize();
      if(loader) loader.style.display='none';
    }
  },350);
}

