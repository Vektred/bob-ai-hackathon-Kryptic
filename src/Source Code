<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BOB.SYS — Missing Person Investigation Assistant</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
  /* ── scrollbars ── */
  .custom-scroll::-webkit-scrollbar{width:6px;height:6px}
  .custom-scroll::-webkit-scrollbar-track{background:transparent}
  .custom-scroll::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:99px}
  .custom-scroll::-webkit-scrollbar-thumb:hover{background:#94a3b8}

  /* ── Leaflet popup ── */
  .leaflet-popup-content-wrapper{border-radius:10px;box-shadow:0 10px 25px rgba(0,0,0,.15)}
  .leaflet-popup-content{font-family:system-ui,sans-serif;margin:12px 14px}

  /* ── pulse ring for newest timeline dot ── */
  @keyframes ping{75%,100%{transform:scale(2);opacity:0}}
  .ping{animation:ping 1.2s cubic-bezier(0,0,.2,1) infinite}

  /* ── AI loader spin ── */
  @keyframes spin{to{transform:rotate(360deg)}}
  .spin{animation:spin 1s linear infinite}

  /* ── status blink ── */
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
  .blink{animation:blink 1.4s ease-in-out infinite}

  /* ── print overrides ── */
  @media print{
    #sidebar,#topbar,#leftsidebar,#tabnav,#printbtn,#doccontrols{display:none!important}
    #printarea{display:block!important;padding:0;margin:0}
    body{background:#fff}
  }
</style>
</head>
<body class="bg-slate-100 text-slate-900 font-sans overflow-hidden h-screen flex">

<!-- ══════════════════════════════════════════════
     SIDEBAR
══════════════════════════════════════════════ -->
<aside id="sidebar" class="w-64 bg-slate-950 border-r border-slate-800 flex flex-col shrink-0 shadow-2xl z-20">
  <!-- Brand -->
  <div class="h-16 flex items-center px-6 border-b border-slate-800">
    <svg class="w-6 h-6 text-blue-500 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <h1 class="font-bold text-lg text-white tracking-wide">BOB<span class="text-blue-500 font-light">.SYS</span></h1>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-6 space-y-1">
    <button onclick="setPage('dashboard')" id="nav-dashboard"
      class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors bg-blue-600/10 text-blue-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      Case Dashboard
    </button>
    <button onclick="setPage('directory')" id="nav-directory"
      class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-400 hover:bg-slate-900 hover:text-slate-200">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      Active Directory
    </button>
    <button onclick="setPage('resources')" id="nav-resources"
      class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-400 hover:bg-slate-900 hover:text-slate-200">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
      Resources & Help
    </button>
  </nav>

  <!-- NCRB context -->
  <div class="p-4 border-t border-slate-800 space-y-3">
    <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-3">
      <p class="text-amber-400 text-[10px] font-bold uppercase tracking-wider mb-1">NCRB 2022 Statistic</p>
      <p class="text-amber-300 text-xs font-semibold">India: 80,000+ children go missing every year</p>
      <p class="text-amber-500/70 text-[10px] mt-1">First 24 hours are critical.</p>
    </div>
    <!-- Investigator badge -->
    <div class="px-3 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center border border-slate-700 text-xs font-bold text-slate-300">IO</div>
      <div class="flex flex-col">
        <span class="text-xs font-medium text-slate-300">Investigator Desk</span>
        <span class="text-[10px] text-slate-500">Ahmedabad Crime Branch</span>
      </div>
    </div>
  </div>
</aside>

<!-- ══════════════════════════════════════════════
     MAIN COLUMN
══════════════════════════════════════════════ -->
<div class="flex-1 flex flex-col min-w-0">

  <!-- TOP BAR -->
  <header id="topbar" class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0 shadow-sm z-10">
    <div class="flex items-center gap-4">
      <div class="bg-slate-100 px-3 py-1.5 rounded-md border border-slate-200 flex items-center gap-2">
        <span class="text-xs font-bold text-slate-500">CASE ID:</span>
        <span id="hdr-caseid" class="text-sm font-mono font-bold text-slate-800">GJ-2026-8924</span>
      </div>
      <div class="px-2 py-1 bg-red-100 text-red-700 text-xs font-bold rounded flex items-center gap-1.5 border border-red-200">
        <span class="w-2 h-2 bg-red-500 rounded-full blink"></span>
        ACTIVE · CRITICAL
      </div>
    </div>
    <div class="flex items-center gap-3 bg-slate-900 px-4 py-1.5 rounded-lg shadow">
      <svg class="w-5 h-5 text-amber-400 blink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <p class="text-amber-400 font-bold text-[10px] tracking-wider leading-none mb-0.5">CRITICAL WINDOW (24H)</p>
        <p id="hdr-elapsed" class="text-white font-mono text-sm leading-none font-semibold">Calculating...</p>
      </div>
    </div>
  </header>

  <!-- WORKSPACE -->
  <main class="flex-1 p-6 overflow-hidden bg-slate-50/50">
    <div class="h-full grid grid-cols-1 xl:grid-cols-12 gap-6 min-h-0">

      <!-- LEFT PANEL (forms) -->
      <div id="leftsidebar" class="xl:col-span-4 flex flex-col gap-6 overflow-y-auto custom-scroll pr-1 pb-4 h-full">
        <!-- Family Intake Form — filled in Step 2 -->
        <div id="intake-section"></div>
        <!-- Intelligence Log Form — filled in Step 3 -->
        <div id="log-section"></div>
      </div>

      <!-- RIGHT PANEL (tabs) -->
      <div class="xl:col-span-8 flex flex-col h-full overflow-hidden bg-white rounded-xl shadow-sm border border-slate-200">
        <!-- Tab nav — filled in Step 4+ -->
        <div id="tabnav" class="flex items-center bg-slate-50 px-4 py-3 shrink-0 border-b border-slate-100 overflow-x-auto custom-scroll">
          <!-- tabs injected by JS -->
        </div>
        <!-- Tab content area -->
        <div id="tabcontent" class="flex-1 overflow-y-auto custom-scroll bg-slate-50/50 p-6 relative">
          <!-- content injected by JS -->
        </div>
      </div>

    </div>
  </main>
</div><!-- end main column -->

<!-- TOAST -->
<div id="toast" class="fixed bottom-8 right-8 z-[500] hidden items-center gap-3 bg-slate-900 text-white px-6 py-4 rounded-xl shadow-2xl border border-slate-700">
  <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <span id="toast-msg" class="font-semibold text-sm"></span>
</div>

<!-- PRINT AREA (hidden on screen) -->
<div id="printarea" class="hidden"></div>

<!-- ══════════════════════════════════════════════
     JAVASCRIPT — Step 1 bootstrap only
══════════════════════════════════════════════ -->
<script>
// ─── Seed data ────────────────────────────────────────────────────────────────
const now = new Date();
const timeMissingDate  = new Date(now.getTime() - (14*60*60*1000) - (35*60*1000));
const tip1Date         = new Date(now.getTime() - (12*60*60*1000));
const tip2Date         = new Date(now.getTime() - (2*60*60*1000));

function toInputFmt(d){ const x=new Date(d); x.setMinutes(x.getMinutes()-x.getTimezoneOffset()); return x.toISOString().slice(0,16); }

let caseData = {
  caseId: 'GJ-2026-8924',
  status: 'ACTIVE_CRITICAL',
  intake: {
    name:'Aarav Patel', age:'8', gender:'Male',
    height:'120', weight:'25',
    clothing:'Yellow t-shirt with Spiderman logo, blue denim shorts, green sandals.',
    lastKnownLocation:'Vastrapur Lake Entry Gate, Ahmedabad',
    timeMissing: toInputFmt(timeMissingDate),
    reporterName:'Priya Patel (Mother)', contactInfo:'+91 98765 43210',
    distinguishingMarks:'Small scar on left knee. Speaks Hindi and Gujarati.',
    schoolName:'Kendriya Vidyalaya, Vastrapur'
  },
  logs: [
    { id:'L1', source:'CCTV Footage', timestamp:toInputFmt(tip2Date),
      location:'SG Highway near Iscon Crossroads',
      coords:[23.0295,72.5085],
      description:'Traffic camera picks up a child matching the description walking alone towards the eastbound AMTS bus stop. Appears unharmed but looking around confused.',
      confidence:'High' },
    { id:'L2', source:'Phone Tip', timestamp:toInputFmt(tip1Date),
      location:'Ice Cream Stall, Vastrapur',
      coords:[23.0360,72.5255],
      description:'Vendor reports seeing a crying boy in a yellow shirt. A middle-aged woman approached him and they walked off together towards the main road.',
      confidence:'Medium' }
  ]
};

// ─── Active page / tab ────────────────────────────────────────────────────────
let activePage = 'dashboard';
let activeTab  = 'overview';
let activeDoc  = 'fir';

// ─── Sidebar navigation ───────────────────────────────────────────────────────
function setPage(p){
  activePage = p;
  document.querySelectorAll('.nav-btn').forEach(b => {
    b.className = b.className.replace(/bg-blue-600\/10 text-blue-400/g,'').replace(/text-slate-400/g,'').trim();
    b.classList.add('text-slate-400','hover:bg-slate-900','hover:text-slate-200');
  });
  const active = document.getElementById('nav-'+p);
  if(active){ active.classList.remove('text-slate-400','hover:bg-slate-900','hover:text-slate-200'); active.classList.add('bg-blue-600/10','text-blue-400'); }
  renderAll();
}

// ─── Toast ────────────────────────────────────────────────────────────────────
let toastTimer;
function showToast(msg){
  const t=document.getElementById('toast'), m=document.getElementById('toast-msg');
  m.textContent=msg; t.classList.remove('hidden'); t.classList.add('flex');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>{ t.classList.add('hidden'); t.classList.remove('flex'); },4000);
}

// ─── Elapsed time ─────────────────────────────────────────────────────────────
function updateElapsed(){
  const start = new Date(caseData.intake.timeMissing).getTime();
  const diff  = Date.now()-start;
  if(diff<0){ document.getElementById('hdr-elapsed').textContent='Future Date'; return; }
  const h=Math.floor(diff/3600000), m=Math.floor((diff%3600000)/60000);
  document.getElementById('hdr-elapsed').textContent=`Elapsed: ${h}h ${m}m`;
}
updateElapsed();
setInterval(updateElapsed,30000);

// ─── Date formatter ───────────────────────────────────────────────────────────
function fmtDate(s){
  if(!s) return 'Not set';
  const d=new Date(s); if(isNaN(d)) return 'Invalid';
  const dd=String(d.getDate()).padStart(2,'0'), mm=String(d.getMonth()+1).padStart(2,'0'), yyyy=d.getFullYear();
  let h=d.getHours(), mi=String(d.getMinutes()).padStart(2,'0'), ap=h>=12?'PM':'AM';
  h=h%12||12; return `${dd}/${mm}/${yyyy} at ${String(h).padStart(2,'0')}:${mi} ${ap}`;
}

// ─── Stub render ─────────────────────────────────────────────────────────────
function renderAll(){
  document.getElementById('hdr-caseid').textContent = caseData.caseId;
  // Left panel and right tabs are dashboard-only
  const left  = document.getElementById('leftsidebar');
  const right = document.querySelector('.xl\\:col-span-8');
  if(activePage==='dashboard'){
    if(left)  left.style.display='';
    if(right) right.style.display='';
    renderIntakeForm();
    renderLogForm();
    renderTabNav();
    renderTabContent();
  } else {
    // Non-dashboard pages: hide left panel, full-width right with page content
    if(left)  left.style.display='none';
    if(right){ right.style.display=''; right.className='xl:col-span-12 flex flex-col h-full overflow-hidden bg-white rounded-xl shadow-sm border border-slate-200'; }
    document.getElementById('tabnav').innerHTML='';
    renderPageContent();
  }
}

function renderPageContent(){
  const tc = document.getElementById('tabcontent');
  if(activePage==='directory'){
    tc.innerHTML=`<div class="max-w-3xl mx-auto py-8">
      <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        Active Case Directory
      </h2>
      <div class="space-y-3">
        ${[{id:'GJ-2026-8924',name:'Aarav Patel',age:8,status:'ACTIVE',elapsed:'14h 35m',loc:'Vastrapur, Ahmedabad'},
           {id:'GJ-2026-7201',name:'Fatima Shaikh',age:14,status:'CLOSED',elapsed:'72h',loc:'Surat, Udhna'},
           {id:'GJ-2026-6834',name:'Ravi Mehta',age:11,status:'ACTIVE',elapsed:'8h 20m',loc:'Vadodara, Alkapuri'}
        ].map(c=>`
        <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-center justify-between shadow-sm hover:shadow-md transition-shadow cursor-pointer" onclick="activePage='dashboard';setPage('dashboard')">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-xs font-black text-slate-500">${c.age}</div>
            <div>
              <p class="font-bold text-slate-900">${c.name}</p>
              <p class="text-xs text-slate-500">${c.loc} &bull; Case ${c.id}</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono text-slate-500">${c.elapsed}</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${c.status==='ACTIVE'?'bg-red-100 text-red-700 border border-red-200':'bg-green-100 text-green-700 border border-green-200'}">${c.status}</span>
          </div>
        </div>`).join('')}
      </div>
    </div>`;
  } else if(activePage==='resources'){
    tc.innerHTML=`<div class="max-w-3xl mx-auto py-8 space-y-4">
      <h2 class="text-xl font-bold text-slate-800 mb-6">Emergency Resources</h2>
      ${[
        {title:'Childline India',contact:'1098',desc:'24×7 child helpline — free from any phone.'},
        {title:'Police Control Room',contact:'100',desc:'Ahmedabad City Police emergency line.'},
        {title:'NCRB Missing Persons Portal',contact:'trackthemissingchild.gov.in',desc:'National database for missing children.'},
        {title:'AMTS Control Room',contact:'079-26576111',desc:'Ahmedabad bus network for transit alerts.'},
        {title:'Railway GRP Ahmedabad',contact:'079-22127900',desc:'Government Railway Police — station coverage.'}
      ].map(r=>`
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-start gap-4 shadow-sm">
        <div class="w-10 h-10 bg-blue-50 border border-blue-100 rounded-lg flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.49 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div>
          <p class="font-bold text-slate-900">${r.title}</p>
          <p class="text-blue-600 font-mono font-bold text-sm">${r.contact}</p>
          <p class="text-xs text-slate-500 mt-0.5">${r.desc}</p>
        </div>
      </div>`).join('')}
    </div>`;
  }
}

// ─── HTML-escape helper ──────────────────────────────────────────────────────
function e(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ─── STEP 2 : Family Intake Form ─────────────────────────────────────────────
function renderIntakeForm(){
  const i = caseData.intake;
  document.getElementById('intake-section').innerHTML = `
  <section class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden shrink-0">
    <div class="bg-slate-800 border-b border-slate-700 px-5 py-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
      <h2 class="font-bold text-white text-sm tracking-wide">Family Intake Form</h2>
      <span class="ml-auto text-[10px] bg-red-500/20 text-red-300 border border-red-500/30 px-2 py-0.5 rounded uppercase font-bold">Critical</span>
    </div>
    <form id="intakeForm" onsubmit="submitIntake(event)" class="p-4 space-y-3">
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Subject Full Name *</label>
        <input type="text" name="name" value="${e(i.name)}" required
          class="w-full text-sm rounded-md border border-slate-300 p-2 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none" />
      </div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Age *</label>
          <input type="number" name="age" value="${e(i.age)}" min="0" max="120" required
            class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Gender *</label>
          <select name="gender" class="w-full text-sm rounded-md border border-slate-300 p-2 bg-white outline-none focus:ring-2 focus:ring-blue-500/20">
            <option value="Male" ${i.gender==='Male'?'selected':''}>Male</option>
            <option value="Female" ${i.gender==='Female'?'selected':''}>Female</option>
            <option value="Other" ${i.gender==='Other'?'selected':''}>Other</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Ht (cm)</label>
          <input type="number" name="height" value="${e(i.height)}"
            class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
        </div>
      </div>
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Clothing Description *</label>
        <textarea name="clothing" rows="2" required
          class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20 resize-none">${e(i.clothing)}</textarea>
      </div>
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Distinguishing Marks / Language</label>
        <input type="text" name="distinguishingMarks" value="${e(i.distinguishingMarks)}"
          class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
      </div>
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">School / Institution</label>
        <input type="text" name="schoolName" value="${e(i.schoolName)}"
          class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
      </div>
      <div class="bg-red-50 p-3 rounded-lg border border-red-200 space-y-3">
        <div>
          <label class="block text-[11px] font-bold text-red-800 mb-1 uppercase tracking-wider">Last Known Location *</label>
          <input type="text" name="lastKnownLocation" value="${e(i.lastKnownLocation)}" required
            class="w-full text-sm rounded-md border border-red-200 p-2 outline-none focus:ring-2 focus:ring-red-400/30 bg-white" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-red-800 mb-1 uppercase tracking-wider">Date & Time Last Seen *</label>
          <input type="datetime-local" name="timeMissing" value="${e(i.timeMissing)}" required
            class="w-full text-sm rounded-md border border-red-200 p-2 outline-none focus:ring-2 focus:ring-red-400/30 bg-white" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Reporter Name *</label>
          <input type="text" name="reporterName" value="${e(i.reporterName)}" required
            class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-600 mb-1 uppercase tracking-wider">Contact No. *</label>
          <input type="tel" name="contactInfo" value="${e(i.contactInfo)}" required
            class="w-full text-sm rounded-md border border-slate-300 p-2 outline-none focus:ring-2 focus:ring-blue-500/20" />
        </div>
      </div>
