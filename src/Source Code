  if(!el) return;
  const win = window.open('','_blank');
  win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${activeDoc==='fir'?'FIR':'Missing Person Poster'}</title>
  <style>body{font-family:serif;margin:32px;color:#000}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:6px 8px;font-size:12px}h1{font-size:24px}h2{font-size:18px}</style>
  </head><body>${el.outerHTML}</body></html>`);
  win.document.close();
  win.focus();
  setTimeout(()=>{ win.print(); win.close(); },400);
}

// ─── STEP 8 : Master renderTabContent (wires everything together) ─────────────
function renderTabContent(){
  const tc = document.getElementById('tabcontent');
  if(activeTab==='overview'){
    tc.innerHTML = renderOverviewTab();
  } else if(activeTab==='map'){
    tc.innerHTML = renderMapTab();
    setTimeout(()=>{ initMap(); setTimeout(injectMapLegend,500); },50);
  } else if(activeTab==='ai'){
    tc.innerHTML = renderAITab();
  } else if(activeTab==='documents'){
    tc.innerHTML = renderDocumentsTab();
  }
}

renderAll();
</script>
