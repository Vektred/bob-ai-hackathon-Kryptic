function submitLog(ev){
  ev.preventDefault();
  const fd = new FormData(ev.target);
  const entry = Object.fromEntries(fd.entries());
  entry.id = 'L' + Date.now();

  // simple geocode from location name
  const loc = entry.location.toLowerCase();
  let coords = [23.0384+(Math.random()-.5)*.018, 72.5298+(Math.random()-.5)*.018];
  if(loc.includes('thaltej'))    coords=[23.0488,72.5117];
  else if(loc.includes('navrangpura')) coords=[23.0364,72.5459];
  else if(loc.includes('satellite'))  coords=[23.0276,72.5218];
  else if(loc.includes('bopal'))      coords=[23.0333,72.4633];
  else if(loc.includes('prahlad'))    coords=[23.0120,72.5026];
  else if(loc.includes('sg highway')) coords=[23.0295,72.5085];
  else if(loc.includes('vastrapur'))  coords=[23.0360,72.5255];
  entry.coords = coords;

  caseData.logs.unshift(entry);
  ev.target.reset();
  renderLogForm();   // re-render with new entry
  setTab('map');     // jump to map to see the new pin
  showToast(`✓ ${entry.source} logged at ${entry.location}`);
}

